# Переменные для docker-compose.yml в корне репозитория (не backend/.env,
# не frontend/.env.local — у них свои файлы).

# host:port агента «Вера» (vera_agent_service), к которому nginx
# проксирует SSE-стрим ответов (`/vera/sse/{session_id}`), см.
# docs/VERA_AGENT_INTEGRATION_PLAN.md. Адресация — только host:port,
# без общей docker-сети с vera_agent_service.
# Прод — реальный адрес сервера, где развёрнут vera_agent_service.
# Локально (Windows/Mac, vera_agent_service поднят своим docker compose
# рядом) — host.docker.internal:8010.
AGENT_SSE_UPSTREAM=host.docker.internal:8010
