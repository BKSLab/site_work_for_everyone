# URL внешнего API (вакансии, регионы и т.д.)
API_URL=http://your-api-server:90

# Ключ для доступа к API
API_KEY=wfe_your-api-key-here

# URL бекенда аутентификации
# Локально: http://127.0.0.1:8000
# Docker:   http://backend:8000
AUTH_API_URL=http://backend:8000

# Полный origin Agent Service для локального `next dev` без Nginx.
# В production путь `/vera/sse/*` проксирует корневой Nginx через
# `AGENT_SSE_UPSTREAM` из корневого `.env`.
AGENT_SSE_ORIGIN=http://91.218.115.104:8010

# Одинаковый секрет на frontend и backend сайта. Используется только
# серверными процессами для анонимных сессий Веры.
VERA_SESSION_SIGNING_KEY=generate-a-long-random-shared-secret
