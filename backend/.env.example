# База данных PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_NAME=postgres

# API ключ для hh.ru
ACCESS_TOKEN_HH=your-hh-api-token

# Email (SMTP)
FROM_EMAIL=your@email.ru
HOST_NAME=smtp.mail.ru
PORT=465
APPLICATION_KEY=your-smtp-app-password
FEEDBACK_EMAIL=feedback@your-domain.ru

# JWT
BASE_ALGORITM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Внутренний API ключ (должен совпадать с API_KEY во фронтенде)
API_WFE_KEY=wfe_your-key-here

# Admin панель (SQLAdmin)
SECRET_KEY=your-secret-key
ADMIN_LOGIN=admin
ADMIN_PASSWORD=your-admin-password

# RabbitMQ (публикация вопросов агенту «Вера», очередь agent.requests в
# vera_agent_service). Общий брокер для всех проектов — отдельный
# репозиторий rabbitmq_service_prod (см. его README.md). Хост:
#   - backend запущен из venv прямо на хосте -> localhost
#   - backend в своём docker-контейнере (docker compose up в этом
#     репозитории), брокер на том же хосте (см. extra_hosts в
#     docker-compose.yml)                    -> host.docker.internal
#   - реальный прод, брокер на другом сервере -> его адрес/DNS-имя
RABBITMQ_URL=amqp://vera_broker:change-me-to-match-rabbitmq_service_prod@host.docker.internal:5672/
RABBITMQ_QUEUE=agent.requests

# Server API Agent Service (история и обратная связь). Ключ хранится
# только на backend сайта и
# никогда не передаётся в браузер или frontend-переменные.
VERA_AGENT_API_URL=http://91.218.115.104:8010
VERA_AGENT_API_KEY=your-vera-agent-api-key
VERA_SESSION_SIGNING_KEY=generate-a-long-random-shared-secret
